                reader.readAsDataURL(file);
            }
        }

        function saveNewSiteAvatar() {
            if (tempAvatarData) {
                try {
                    document.getElementById('siteAvatar').src = tempAvatarData;
                    localStorage.setItem('nokia_mod_avatar', tempAvatarData);
                    alert("Đã thay đổi Avatar Web!");
                    closeAdminModal();
                } catch (err) {
                    alert("Ảnh avatar dung lượng quá lớn!");
                }
            } else {
                alert("Chọn ảnh trước!");
            }
        }

        function loadSiteAvatar() {
            const savedAvatar = localStorage.getItem('nokia_mod_avatar');
            if (savedAvatar) {
                document.getElementById('siteAvatar').src = savedAvatar;
                document.getElementById('previewAvatar').src = savedAvatar;
            }
        }

        function openAdminModal(tabName = 'general') {
            document.getElementById('adminModal').classList.remove('hidden');
            if (isAuthorized) {
                document.getElementById('pinStep').classList.add('hidden');
                document.getElementById('adminPanel').classList.remove('hidden');
                switchAdminTab(tabName === 'avatar' ? 'avatar' : 'game');
            } else {
                document.getElementById('pinStep').classList.remove('hidden');
                document.getElementById('adminPanel').classList.add('hidden');
                document.getElementById('pinInput').focus();
            }
        }

        function openAdminModalForGame(gameId) {
            openAdminModal('game');
            if (isAuthorized) {
                document.getElementById('gameSelect').value = gameId;
                loadGameToEdit();
            }
        }

        function closeAdminModal() {
            document.getElementById('adminModal').classList.add('hidden');
            document.getElementById('pinInput').value = '';
        }

        function verifyPin() {
            const input = document.getElementById('pinInput').value;
            if (input === ADMIN_PIN) {
                isAuthorized = true;
                document.getElementById('pinStep').classList.add('hidden');
                document.getElementById('adminPanel').classList.remove('hidden');
                switchAdminTab('game');
            } else {
                alert('Mã PIN không đúng!');
                document.getElementById('pinInput').value = '';
            }
        }

        function switchAdminTab(tab) {
            const tabs = ['game', 'price', 'add', 'avatar', 'stats', 'dailyStats'];
            tabs.forEach(t => {
                const btn = document.getElementById('tabBtn' + t.charAt(0).toUpperCase() + t.slice(1));
                const content = document.getElementById('tab' + t.charAt(0).toUpperCase() + t.slice(1) + 'Content');
                
                if (t === tab) {
                    if (btn) {
                        btn.className = "px-2.5 py-1 rounded-lg font-bold bg-sky-500 text-white transition whitespace-nowrap";
                    }
                    if (content) content.classList.remove('hidden');
                } else {
                    if (btn) {
                        btn.className = "px-2.5 py-1 rounded-lg font-bold bg-slate-800 text-slate-400 hover:text-white transition whitespace-nowrap";
                    }
                    if (content) content.classList.add('hidden');
                }
            });

            if (tab === 'stats') {
                renderAdminStats();
            } else if (tab === 'dailyStats') {
                renderDailyStatsTable();
            }
        }

        function resetAllModViews() {
            if (confirm("Reset lượt tương tác của tất cả các Mod về 0?")) {
                gamesData.forEach(g => g.views = 0);
                localStorage.setItem('nokia_mod_games', JSON.stringify(gamesData));
                renderGames();
                alert("Đã reset lượt view các bản Mod!");
            }
        }

        function resetViewCount() {
            if (confirm("Đặt lại lượt truy cập trang web về 0?")) {
                localStorage.setItem('nokia_mod_views', '0');
                document.getElementById('statViews').innerText = "0";
                document.getElementById('adminTotalViews').innerText = "0";
                alert("Đã reset!");
            }
        }

        // Khởi chạy ứng dụng
        window.onload = function() {
            initViewCounter();
            renderPrices();
            loadSiteAvatar();
            renderGames();
        };
    </script>
</body>
</html>
